{
  "name": "light-rp",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/evaluate.ts",
    "db:local": "wrangler d1 migrations apply lightrp-v3 --local",
    "check": "npm run typecheck && npm test && npm run build && npm run eval",
    "eval:live": "tsx scripts/live-evaluate.ts",
    "eval:quality": "tsx scripts/quality-evaluate.ts",
    "eval:decisions": "tsx scripts/decision-evaluate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "better-sqlite3": "13.0.3",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
