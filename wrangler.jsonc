{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lightrp-v2",
  "account_id": "c02febc38a3cfcb6b91c8832a9724370",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Paid/Standard: max CPU 300000ms (5 min). Covers Queue consumer long GLM
  // turns — cpu_ms is compute time only, not I/O wait.
  "limits": {
    "cpu_ms": 300000
  },
  // Cron every minute: never-started pending (lost Queue after outbox publish) must
  // republish within ~30–60s via PENDING_NEVER_STARTED_GRACE_MS; lease-expiry recovery
  // uses DELIVERY_GRACE_MS=180s; stale-running (no updated_at heartbeat) uses
  // STALE_RUNNING_GRACE_MS=120s even if lease_expires_at is still in the future.
  // Quiet ticks perform zero D1 writes when nothing matches.
  "triggers": { "crons": ["*/1 * * * *"] },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "vars": {
    "AI_GATEWAY_ID": "sillytavern",
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "lightrp",
      "remote": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/v2/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lightrp-v2",
      "database_id": "68e1f897-e8ed-4a87-8086-9c5f65b824d0",
      "remote": true,
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [{ "binding": "GENERATE_QUEUE", "queue": "lightrp-v2-generate" }],
    "consumers": [
      {
        "queue": "lightrp-v2-generate",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "lightrp-v2-generate-dlq",
      },
    ],
  },
}
