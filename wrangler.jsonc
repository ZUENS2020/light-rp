{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lightrp-v3",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "ip": "127.0.0.1", "host": "127.0.0.1", "port": 8787 },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "lightrp-preview.zuens2020.work", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "zuens2020.cloudflareaccess.com",
    "ACCESS_AUD": "120b4e71926c0cde96cb2ba921cd1c4e8e57233e3b065b7dc1ded7cdc2beed2e",
    "AI_GATEWAY_ID": "sillytavern",
    "MODEL_MODE": "gateway",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lightrp-v3",
      "database_id": "a2f4f14d-d5ee-41c4-92d8-81c2fee37272",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "lightrp-v3" }],
  "vectorize": [{ "binding": "VECTORS", "index_name": "lightrp-v3-bge-m3" }],
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "BRANCH_RUNTIME", "class_name": "BranchRuntime" }] },
  "migrations": [{ "tag": "v3-branch-runtime", "new_sqlite_classes": ["BranchRuntime"] }],
  "workflows": [
    {
      "name": "lightrp-v3-generation",
      "binding": "GENERATION",
      "class_name": "GenerationWorkflow",
    },
    { "name": "lightrp-v3-memory", "binding": "MEMORY", "class_name": "MemoryWorkflow" },
  ],
  "triggers": { "crons": ["*/1 * * * *"] },
}
