{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lightrp",
  "account_id": "c02febc38a3cfcb6b91c8832a9724370",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "LLM_BASE_URL": "https://integrate.api.nvidia.com/v1",
    "LLM_MODEL": "moonshotai/kimi-k3",
    "NMEM_API_URL": "https://necmem.zuens2020.work/remote-api"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "lightrp",
      "remote": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lightrp",
      "database_id": "12151806-335e-4fba-8197-81820c19abd3",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "GENERATE_QUEUE", "queue": "lightrp-generate" }],
    "consumers": [{ "queue": "lightrp-generate", "max_batch_size": 1, "max_retries": 2 }]
  }
}
